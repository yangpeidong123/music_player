<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="*" name="music_player" type="win32"/>
  <description>音乐播放器</description>
  
  <!-- Windows 系统媒体传输控制 (SMTC) 支持 -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b641444a6b6b"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  
  <!-- DPI 感知 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  
  <!-- COM 支持（SMTC 需要） -->
  <comInterfaceExternalProxyStub
    name="IMediaTransportControl"
    iid="{00000000-0000-0000-0000-000000000000}"
    proxyStubClsid32="{00000000-0000-0000-0000-000000000000}"
  />
</assembly>
